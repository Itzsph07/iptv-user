{
  "expo": {
    "sdkVersion": "54.0.0",
    "orientation": "landscape",
    "name": "MesaIPTV",
    "slug": "iptv-user-app",
    "version": "1.0.0",
    "icon": "./assets/mesaIPTV.png",
    "ios": {
      "deploymentTarget": "15.1",
      "supportsTablet": true,
      "requireFullScreen": true,
      "orientation": ["landscape"],
      "bundleIdentifier": "com.anonymous.MesaIPTV",
      "icon": "./assets/mesaIPTV.png",
      "splash": {
        "image": "./assets/splash-landscape.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      }
    },
    "android": {
      "minSdkVersion": 24,
      "targetSdkVersion": 35,
      "compileSdkVersion": 35,
      "adaptiveIcon": {
        "foregroundImage": "./assets/mesaIPTV.png",
        "backgroundColor": "#000000"
      },
      "icon": "./assets/mesaIPTV.png",
      "roundIcon": "./assets/mesaIPTV.png",
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.MesaIPTV",
      "orientation": ["landscape"],
      "intentFilters": [
        {
          "action": "MAIN",
          "category": ["LAUNCHER", "LEANBACK_LAUNCHER"]
        }
      ],
      "splash": {
        "image": "./assets/splash-landscape.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000",
        "mdpi": "./assets/splash-landscape.png",
        "hdpi": "./assets/splash-landscape.png",
        "xhdpi": "./assets/splash-landscape.png",
        "xxhdpi": "./assets/splash-landscape.png",
        "xxxhdpi": "./assets/splash-landscape.png"
      }
    },
    "androidTV": {
      "banner": "./assets/tv-banner.png",
      "icon": "./assets/mesaIPTV.png"
    },
    "web": {
      "favicon": "./assets/mesaIPTV.png",
      "splash": {
        "image": "./assets/splash-landscape.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      }
    },
    "splash": {
      "image": "./assets/splash-landscape.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "extra": {
      "eas": {
        "projectId": "e82b40d7-4454-480a-bd93-d7f36c6b7872"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e82b40d7-4454-480a-bd93-d7f36c6b7872"
    },
    "plugins": [
      "expo-build-properties",
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "showTVMenu": true,
          "showTVRemote": true
        }
      ],
      "expo-splash-screen",
      [
        "react-native-video",
        {
          "enableNotificationControls": true,
          "androidExtensions": {
            "useExoplayerHls": true,
            "useExoplayerRtsp": false,
            "useExoplayerSmoothStreaming": false,
            "useExoplayerDash": false
          }
        }
      ]
    ],
    "owner": "mesashop"
  }
}