{
  "expo": {
    "sdkVersion": "54.0.0",
    "orientation": "landscape",
    "name": "MesaIPTV",
    "slug": "iptv-user-app",
    "version": "1.0.0",
    "icon": "./assets/mesaIPTV.png",
    "ios": {
      "deploymentTarget": "15.1",
      "supportsTablet": true,
      "requireFullScreen": true,
      "orientation": [
        "landscape"
      ],
      "bundleIdentifier": "com.anonymous.MesaIPTV",
      "icon": "./assets/mesaIPTV.png",
      "splash": {
        "image": "./assets/splash-landscape.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      }
    },
    "android": {
      "minSdkVersion": 24,
      "targetSdkVersion": 35,
      "compileSdkVersion": 35,
      "buildToolsVersion": "35.0.0",
      "newArchEnabled": false,
      "agpVersion": "8.9.0",
      "adaptiveIcon": {
        "foregroundImage": "./assets/mesaIPTV.png",
        "backgroundColor": "#000000"
      },
      "icon": "./assets/mesaIPTV.png",
      "roundIcon": "./assets/mesaIPTV.png",
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.MesaIPTV",
      "orientation": [
        "landscape"
      ],
      "intentFilters": [
        {
          "action": "MAIN",
          "category": [
            "LAUNCHER",
            "LEANBACK_LAUNCHER"
          ]
        }
      ],
      "splash": {
        "image": "./assets/splash-landscape.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000",
        "mdpi": "./assets/splash-landscape.png",
        "hdpi": "./assets/splash-landscape.png",
        "xhdpi": "./assets/splash-landscape.png",
        "xxhdpi": "./assets/splash-landscape.png",
        "xxxhdpi": "./assets/splash-landscape.png"
      },
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "androidTV": {
      "banner": "./assets/tv-banner.png",
      "icon": "./assets/mesaIPTV.png"
    },
    "web": {
      "favicon": "./assets/mesaIPTV.png",
      "splash": {
        "image": "./assets/splash-landscape.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      }
    },
    "splash": {
      "image": "./assets/splash-landscape.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "extra": {
      "eas": {
        "projectId": "62895f48-7736-48a5-a8c3-cc4c24f6e7c1"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {},
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false
          }
        }
      ],
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "showTVMenu": true,
          "showTVRemote": true
        }
      ],
      "expo-splash-screen",
      [
        "react-native-video",
        {
          "enableNotificationControls": true,
          "androidExtensions": {
            "useExoplayerHls": true,
            "useExoplayerRtsp": false,
            "useExoplayerSmoothStreaming": false,
            "useExoplayerDash": false,
            "useExoplayerSoftwareDecoder": true
          }
        }
      ],
      "expo-font"
    ],
    "owner": "mesashop01"
  }
}
