{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "preview-apk": {
      "extends": "preview",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview-apk"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "tv": {
      "extends": "production",
      "channel": "tv",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "image": "latest"
      },
      "env": {
        "EXPO_TV": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}